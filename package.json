{
  "name": "baduk-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 43212",
    "build": "tsc -b && vite build",
    "start": "serve dist -s -l tcp://0.0.0.0:$PORT",
    "preview": "vite preview --port 43212",
    "typecheck": "tsc -b",
    "check:lessons": "npx --yes tsx --tsconfig tsconfig.json scripts/check-lessons.ts",
    "check:exams": "npx --yes tsx --tsconfig tsconfig.json scripts/check-exams.ts",
    "build:exams": "npx --yes tsx --tsconfig tsconfig.json scripts/build-handmade-exams.ts",
    "build:practice": "npx --yes tsx --tsconfig tsconfig.json scripts/generate-practice-banks.ts",
    "build:practice:legacy": "npx --yes tsx --tsconfig tsconfig.json scripts/build-practice-banks.ts",
    "check:practice": "npx --yes tsx --tsconfig tsconfig.json scripts/check-practice.ts",
    "fetch:exams": "node scripts/fetch-exam-problems.mjs",
    "fetch:practice": "node scripts/fetch-practice-problems.mjs",
    "fetch:goproblems": "node scripts/fetch-goproblems-practice.mjs",
    "cap:sync": "npm run build && cap sync",
    "ios": "npm run cap:sync && cap open ios",
    "android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/outfit": "^5.3.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "serve": "^14.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
